{
  "expo": {
    "name": "SwiftRide",
    "slug": "swiftride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4B2CE0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swiftride.passenger",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SwiftRide uses your location to set pickup points and find nearby rides."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4B2CE0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.swiftride.passenger",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SwiftRide uses your location to set pickup points and find nearby rides."
        }
      ]
    ]
  }
}
